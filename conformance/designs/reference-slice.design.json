{
  "name": "reference-slice",
  "contract_version": 2,
  "description": "The v2 north-star eval slice: a sales-engagement backend (workspaces, leads, api keys, billing webhooks) modeled on a real app. Tenant-scoped, JWT-guarded, with declared background jobs and realtime channels.",
  "auth": { "model": "jwt", "roles": ["owner", "member"] },
  "dependencies": ["db", "auth", "validate", "observe", "oauth"],
  "tenancy": { "entity": "Workspace", "member_roles": ["owner", "member"] },
  "realtime": {
    "changes": ["Lead"],
    "broadcast": [{ "name": "deal_room", "scope": "tenant" }],
    "presence": [{ "name": "editors", "scope": "tenant" }]
  },
  "jobs": [
    { "name": "expire_trials", "schedule": "0 * * * *", "queue": "billing" },
    { "name": "overdue_callbacks", "schedule": "*/5 * * * *" }
  ],
  "modules": [
    {
      "name": "users",
      "entities": [
        { "name": "User", "fields": [
          { "name": "id", "type": "integer" },
          { "name": "email", "type": "string", "unique": true },
          { "name": "password", "type": "string" },
          { "name": "role", "type": "string", "values": ["admin", "user"] }
        ]}
      ],
      "endpoints": [
        { "operation_id": "register", "method": "POST", "path": "/register",
          "public": true,
          "request_body": { "entity": "User" },
          "success": { "status": 201, "entity": "User" },
          "errors": [
            { "status": 409, "when": "email already registered" },
            { "status": 422, "when": "request body fails validation" }
          ] },
        { "operation_id": "login", "method": "POST", "path": "/login",
          "public": true,
          "success": { "status": 200 },
          "errors": [{ "status": 401, "when": "invalid email or password" }] }
      ]
    },
    {
      "name": "workspaces",
      "entities": [
        { "name": "Workspace", "fields": [
          { "name": "id", "type": "integer" },
          { "name": "name", "type": "string" },
          { "name": "plan", "type": "string", "values": ["trial", "pro"] },
          { "name": "seat_limit", "type": "integer" },
          { "name": "seats_used", "type": "integer", "default": 0, "reserve_against": "seat_limit" }
        ]}
      ],
      "endpoints": [
        { "operation_id": "list_workspaces", "method": "GET", "path": "/",
          "public": true,
          "success": { "status": 200, "entity": "Workspace", "list": true } },
        { "operation_id": "create_workspace", "method": "POST", "path": "/",
          "auth_required": true,
          "request_body": { "entity": "Workspace" },
          "success": { "status": 201, "entity": "Workspace" },
          "errors": [{ "status": 422, "when": "request body fails validation" }] },
        { "operation_id": "show_workspace", "method": "GET", "path": "/{id}",
          "public": true,
          "success": { "status": 200, "entity": "Workspace" },
          "errors": [{ "status": 404, "when": "unknown id" }] }
      ]
    },
    {
      "name": "leads",
      "entities": [
        { "name": "Lead",
          "belongs_to": [{ "entity": "Workspace", "on_delete": "cascade" }],
          "fields": [
            { "name": "id", "type": "integer" },
            { "name": "phone", "type": "string", "unique": true, "index": true },
            { "name": "name", "type": "string" },
            { "name": "status", "type": "string", "values": ["new", "called", "dnc"] },
            { "name": "custom", "type": "json", "required": false }
          ]}
      ],
      "endpoints": [
        { "operation_id": "list_leads", "method": "GET", "path": "/",
          "auth_required": true,
          "success": { "status": 200, "entity": "Lead", "list": true } },
        { "operation_id": "create_lead", "method": "POST", "path": "/",
          "auth_required": true,
          "request_body": { "entity": "Lead" },
          "success": { "status": 201, "entity": "Lead" },
          "errors": [
            { "status": 409, "when": "phone already exists in this workspace" },
            { "status": 422, "when": "request body fails validation" }
          ] },
        { "operation_id": "show_lead", "method": "GET", "path": "/{id}",
          "auth_required": true,
          "success": { "status": 200, "entity": "Lead" },
          "errors": [{ "status": 404, "when": "unknown id" }] },
        { "operation_id": "update_lead", "method": "PUT", "path": "/{id}",
          "auth_required": true,
          "request_body": { "entity": "Lead" },
          "success": { "status": 200, "entity": "Lead" },
          "errors": [{ "status": 404, "when": "unknown id" }] },
        { "operation_id": "delete_lead", "method": "DELETE", "path": "/{id}",
          "auth_required": true,
          "required_roles": ["owner"],
          "success": { "status": 204 },
          "errors": [
            { "status": 403, "when": "caller is not an owner of this workspace" },
            { "status": 404, "when": "unknown id" }
          ] },
        { "operation_id": "import_leads", "method": "POST", "path": "/import",
          "auth_required": true,
          "success": { "status": 202 } }
      ]
    },
    {
      "name": "api-keys",
      "entities": [
        { "name": "ApiKey",
          "belongs_to": [{ "entity": "Workspace", "on_delete": "cascade" }],
          "fields": [
            { "name": "id", "type": "integer" },
            { "name": "prefix", "type": "string", "unique": true },
            { "name": "label", "type": "string" },
            { "name": "scopes", "type": "string" }
          ]}
      ],
      "endpoints": [
        { "operation_id": "list_api_keys", "method": "GET", "path": "/",
          "auth_required": true,
          "success": { "status": 200, "entity": "ApiKey", "list": true } },
        { "operation_id": "create_api_key", "method": "POST", "path": "/",
          "auth_required": true,
          "request_body": { "entity": "ApiKey" },
          "success": { "status": 201, "entity": "ApiKey" },
          "errors": [{ "status": 422, "when": "request body fails validation" }] },
        { "operation_id": "usage", "method": "GET", "path": "/usage",
          "success": { "status": 200 } },
        { "operation_id": "revoke_api_key", "method": "DELETE", "path": "/{id}",
          "auth_required": true,
          "required_roles": ["owner"],
          "success": { "status": 204 },
          "errors": [
            { "status": 403, "when": "caller is not an owner of this workspace" },
            { "status": 404, "when": "unknown id" }
          ] }
      ]
    },
    {
      "name": "billing",
      "endpoints": [
        { "operation_id": "stripe_webhook", "method": "POST", "path": "/webhook",
          "success": { "status": 200 },
          "errors": [{ "status": 400, "when": "Stripe signature is missing or invalid" }] }
      ]
    },
    {
      "name": "integrations",
      "endpoints": [
        { "operation_id": "google_connect", "method": "GET", "path": "/auth/google/connect",
          "success": { "status": 302 } },
        { "operation_id": "google_callback", "method": "GET", "path": "/auth/google/callback",
          "success": { "status": 200 },
          "errors": [{ "status": 400, "when": "authorization code is missing, bad, or expired" }] }
      ]
    }
  ]
}
